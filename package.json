{
  "name": "coderius-docs",
  "version": "0.0.0",
  "private": true,
  "description": "Coderius-documentatie — monorepo van alle leersites (Docusaurus) met gedeelde resources.",
  "license": "CC-BY-NC-4.0",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20.0"
  },
  "scripts": {
    "build": "pnpm --filter \"./sites/home\" --filter \"./sites/*/*\" -r build",
    "typecheck": "pnpm --filter \"./sites/home\" --filter \"./sites/*/*\" --filter \"./packages/*\" -r typecheck",
    "clear": "pnpm --filter \"./sites/*/*\" -r clear",
    "preview-all": "node scripts/run-all-sites.mjs serve --build",
    "preview-all:nobuild": "node scripts/run-all-sites.mjs serve",
    "sites:start": "node scripts/run-all-sites.mjs start",
    "format": "biome format --write .",
    "lint": "biome check .",
    "spel": "cspell lint --no-progress --relative --no-must-find-files \"sites/*/*/docs/**/*.{md,mdx}\" \"sites/*/*/src/pages/**/*.{md,mdx}\"",
    "stijl": "node scripts/controleer-tekst.mjs",
    "tekst": "node scripts/controleer-tekst-alles.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "cross-links": "node scripts/controleer-cross-links.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@cspell/dict-nl-nl": "^2.4.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "cspell": "^10.1.0",
    "jsdom": "^26.1.0",
    "playwright": "1.56.1",
    "vitest": "catalog:"
  }
}
