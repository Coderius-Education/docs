# ─────────────────────────────────────────────────────────────────────────────
# Coderius docs-monorepo — één .gitignore voor de hele workspace.
# Per-site .gitignores zijn bewust verwijderd; alles staat hier.
# ─────────────────────────────────────────────────────────────────────────────

# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/
.yarn/
jspm_packages/

# ── Build- en Docusaurus-output ──────────────────────────────────────────────
build/
.docusaurus/
.svelte-kit/
.cache-loader/
.cache/
.temp/
.tmp/

# ── CI ───────────────────────────────────────────────────────────────────────
# Het plan van de incrementele CI (scripts/wijzigingen.mjs); elke job haalt
# het als artifact op in de werkmap, en biome mag het niet als bron lezen.
changed.json

# ── TypeScript / bundler / linter caches ─────────────────────────────────────
*.tsbuildinfo
.eslintcache
.stylelintcache

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Omgevingsvariabelen / secrets ────────────────────────────────────────────
.env
.env.local
.env.*.local
*.pem

# ── Test- en coverage-output ─────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Python ───────────────────────────────────────────────────────────────────
# De repo bevat Python-gereedschap (scripts/, de uitgepakte blokken van
# robotica en fullstack). Wie dat lokaal draait, krijgt anders een untracked
# __pycache__ terug.
__pycache__/
*.py[cod]
.pytest_cache/

# ── Editors / IDE's ──────────────────────────────────────────────────────────
.idea/
*.iml
*.swp
*.swo
*~
.project
.classpath
*.sublime-workspace

# ── Backup- / patch-rommel ───────────────────────────────────────────────────
*.bak
*.backup
*.orig
*.rej

# ── Besturingssysteem-rommel ─────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Lokale AI-assistent bestanden ────────────────────────────────────────────
# (CLAUDE.md en .claude/skills/ worden wél gecommit: dat zijn projectinstructies, geen scratch.)
.claude/*
!.claude/skills/
.gemini/
.aider*

# ── Site-specifieke gegenereerde / lokale bestanden ──────────────────────────
# Bewust gescoped per site, zodat een gelijknamig bestand elders niet per
# ongeluk genegeerd wordt.
/sites/informatica/godot/static/zips/
/sites/informatica/algorithms/.trace-tests/
/sites/informatica/dvwa/GEMINI.md
/sites/informatica/play/database.json
/sites/informatica/play/development.py
/sites/informatica/play/TODO.md
# leerlijn.md werd in deze sites gegenereerd (stond in hun originele .gitignore).
/sites/informatica/godot/**/leerlijn.md
/sites/informatica/python/**/leerlijn.md
/sites/informatica/web/**/leerlijn.md
